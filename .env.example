# Nebius Token Factory (OpenAI-compatible). Copy to .env and fill in.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
NEBIUS_PROJECT_ID=

# Nemotron tiers. Nano is eu-north1; Super/Ultra are us-central1 (two base URLs).
NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NANO_BASE_URL=https://api.tokenfactory.nebius.com/v1
SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
SUPER_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
ULTRA_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Tavily (clause text + contractor price ranges; earns the bonus)
TAVILY_API_KEY=
